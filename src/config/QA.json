{
  "environment": "QA",
  "baseURL": "https://www.demoblaze.com",
  "apiURL": "https://api.demoblaze.com",
  "timeout": 30000,
  "shortTimeout": 5000,
  "stepTimeout": 60000,
  "retryCount": 1,
  "browser": "chromium",
  "headless": false,
  "slowMo": 0,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "screenshot": {
    "onFailure": true,
    "fullPage": true,
    "stability": {
      "domContentLoadedTimeout": 5000,
      "networkIdleTimeout": 3000,
      "animationsTimeout": 2000
    }
  },
  "video": {
    "enabled": true,
    "onFailure": true
  },
  "appName": "Demoblaze",
  "spurQualityEnabled": true,
  "wcagStandard": "wcag21aa",
  "a11yEnabled": true,
  "a11yMinImpact": "moderate",
  "a11yReportDir": "reports/accessibility-reports"
}
